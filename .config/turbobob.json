{
	"for_description_of_this_file_see": "https://github.com/function61/turbobob",
	"version_major": 1,
	"project_name": "ubackup",
	"project_emoji_icon": "💾",
	"builders": [
		{
			"name": "default",
			"uses": "docker://fn61/buildkit-golang:20260604_1344_ff654e98",
			"mount_destination": "/workspace",
			"workdir": "/workspace",
			"commands": {
				"build": ["build-go-project.sh", "--directory=cmd/ubackup/", "--binary-basename=ubackup"],
				"dev": ["bash"]
			}
		}
	],
	"docker_images": [
		{
			"image": "fn61/ubackup"
		}
	],
	"os_arches": {
		"linux-amd64": true,
		"linux-arm": true,
		"darwin-amd64": true,
		"windows-amd64": true
	}
}
